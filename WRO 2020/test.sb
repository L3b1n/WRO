condition=0
access="stop"
'Mailbox.Connect("F1")
F2=Mailbox.Create("F2")
'комуникация по блютузу
Thread.Run=comunicate_send
Sub comunicate_send
  While "True"
    If condition=0 Then 
      Mailbox.Send("F1","F1","stop")
    Else
      Mailbox.Send("F1","F1","start")
    EndIf
  EndWhile
EndSub


