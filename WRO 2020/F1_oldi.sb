EndSub

Sub blow
  runD=100
  I=0
  While runD>19
    Motor.Start("D",-100)
    Program.Delay(5)
    If I=5 then 
      runD=Math.Abs(Motor.GetSpeed("D"))
    Else
      I=I+1
    EndIf
  EndWhile
  runD=100
  While runD>20
    Motor.Start("D",100)
    Program.Delay(150)
    runD=Math.Abs(Motor.GetSpeed("D"))
  EndWhile
EndSub