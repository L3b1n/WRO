sub speed_y
  get_compas()
  newangle=betta-Start_angle
  newangle=newangle+180
  If newangle>=0 Then 
    newangle=newangle-360*Math.Floor(newangle/360)
  ElseIf newangle<=0 then
    newangle=-1-newangle
    newangle=newangle-360*Math.Floor(newangle/360)
    newangle=359-newangle
  EndIf
  newangle=newangle-180
  speed=newangle*(1.3)
  speed_right=A+speed
  speed_left=B+speed
  speed_back=C+speed
  Motor.Start("A",speed_right)
  Motor.Start("B",speed_left)
  Motor.Start("C",speed_back)
EndSub

Sub speed_x
  get_compas()
  newangle=betta-Start_angle
  newangle=newangle+180
  If newangle>=0 Then 
    newangle=newangle-360*Math.Floor(newangle/360)
  ElseIf newangle<=0 then
    newangle=-1-newangle
    newangle=newangle-360*Math.Floor(newangle/360)
    newangle=359-newangle
  EndIf
  newangle=newangle-180
  speed=newangle*(1.2)
  speed_right=A+speed
  speed_left=B+speed
  speed_back=C+speed
  Motor.Start("A",speed_right)
  Motor.Start("B",speed_left)
  Motor.Start("C",speed_back)
EndSub

sub speed_purpose
  get_compas()
  newangle=betta-Start_angle
  newangle=newangle+180
  If newangle>=0 Then 
    newangle=newangle-360*Math.Floor(newangle/360)
  ElseIf newangle<=0 then
    newangle=-1-newangle
    newangle=newangle-360*Math.Floor(newangle/360)
    newangle=359-newangle
  EndIf
  newangle=newangle-180
  speed=newangle*(-0.7)
  speed_back=C+speed
  Motor.Start("A",A)
  Motor.Start("B",B)
  Motor.Start("C",speed_back)
EndSub

Sub get_compas
  betta=Sensor.ReadRawValue(Port_compas,0)
  betta=0.0003*betta*betta+1.9228*betta
EndSub


Sub check
  I=Sensor.ReadI2CRegister(Port_seeker,8,73)
  If force>60 then
   While Sensor.ReadI2CRegister(1,8,75)<50 and Sensor.ReadI2CRegister(1,8,76)<50 and Sensor.ReadI2CRegister(1,8,77)<50
     poisk()
   EndWhile
  ElseIf I=1 Then
   one=one+1 
   two=0
   three=0
   seven=0
   eight=0
   nine=0
   zero=0
   force=one
 ElseIf I=2 then
   one=0 
   two=two+1
   three=0
   seven=0
   eight=0
   nine=0
   zero=0
   force=two
 ElseIf I=3 then
   one=0 
   two=0
   three=three+1
   seven=0
   eight=0
   nine=0
   zero=0
   force=three
 ElseIf I=7 then
   one=0 
   two=0
   three=0
   seven=seven+1
   eight=0
   nine=0
   zero=0
   force=seven
 ElseIf I=8 then
   one=0 
   two=0
   three=0
   seven=0
   eight=eight+1
   nine=0
   zero=0
   force=eight
 ElseIf I=9 then
   one=0 
   two=0
   three=0
   seven=0
   eight=0
   nine=nine+1
   zero=0
   force=nine
 ElseIf I=0 then
   one=0 
   two=0
   three=0
   seven=0
   eight=0
   nine=0
   zero=zero+1
   force=zero
 EndIf
EndSub
   


