Thread.Run=odometriy
Px_cm=1'0.585
Py_cm=1'0.6
Sub odometriy
  While "True"
    If type=1 Then
      debug_angel=Math.GetRadians(90)
      count_right=Math.Abs(Motor.GetSpeed("A"))
      count_left=Math.Abs(Motor.GetSpeed("B"))
      count_back=Math.Abs(Motor.GetSpeed("C"))
      
      Vy=(Math.SquareRoot(Math.Power(count_right,2)+Math.Power(count_left,2)+count_right*count_left))*gamma
      Y=Vy*0.005*Py_cm+Y-0.06*condition_y
      
      Vx=((Math.SquareRoot(Math.Power(count_right,2)+Math.Power(count_left,2)-count_right*count_left)+count_back)/2)*rout
      X=Vx*0.005*Px_cm+X+0.06*condition_x
    ElseIf type=0 Then
      Va=Math.Abs(Motor.GetSpeed("A"))
      Vb=Math.Abs(Motor.GetSpeed("B"))
      R=(Va+Vb)*15/2*(Va-Vb)
      alpha=Math.SquareRoot(Va*Va+Vb*Vb+Va*Vb)*0.005/R
      If alpha>0 Then
        X=2*R*Math.Sin(alpha/2)*Math.Cos(debug_angel+alpha/2)+X
        Y=2*R*Math.Sin(alpha/2)*Math.Sin(debug_angel+alpha/2)+Y
        debug_angel=debug_angel+alpha/2
      ElseIf alpha<0 Then
        X=2*R*Math.Sin(alpha/2)*Math.Cos(alpha/2-debug_angel)+X
        Y=2*R*Math.Sin(alpha/2)*Math.Sin(alpha/2-debug_angel)+Y
        debug_angel=debug_angel-alpha/2
      EndIf
    EndIf
    
    count_A=Math.Abs(Motor.GetSpeed("A"))
    count_B=Math.Abs(Motor.GetSpeed("B"))
    While count_A<20  
      While count_B<20
        count_A=Math.Abs(Motor.GetSpeed("A"))
        count_B=Math.Abs(Motor.GetSpeed("B"))    
      EndWhile
      count_A=Math.Abs(Motor.GetSpeed("A"))
      count_B=Math.Abs(Motor.GetSpeed("B"))
    EndWhile
    Program.Delay(5)  
  EndWhile
EndSub


Thread.Run=show
Sub show
  While "True"
    LCD.Clear()
    LCD.Text(1,0,0,2,EV3.BatteryLevel)
    LCD.Text(1,0,20,2,"x=")
    LCD.Text(1,0,40,2,"y=")
    LCD.Text(1,60,20,2,X)
    LCD.Text(1,60,40,2,Y)
    LCD.Text(1,0,60,2,force)
    LCD.Text(1,0,80,2,Sensor.ReadI2CRegister(Port_seeker,8,73))
    Program.Delay(100)
  EndWhile
EndSub

curont=1
Thread.Run=conditions
Sub conditions
  While "True"
    Buttons.Flush()
    If Buttons.Current="D" then
      curont=0
      EV3.SetLEDColor("RED","FLASH")
      D=1
      While D=1
        Motor.Stop("ABC","True")
        X=0
        Y=0
        condition_x=0
        condition_y=0
        If Buttons.Current="R" Then
          D=0
        Else
          D=1
        EndIf
      EndWhile
    Else
      curont=1
      EV3.SetLEDColor("GREEN","FLASH")
      Program.Delay(5)
    EndIf
  EndWhile
EndSub

