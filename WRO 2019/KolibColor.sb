Sensor.SetMode(3,1)
Buttons.Wait()
near=Sensor.ReadPercent(3)
N=EV3File.OpenWrite("wro2019/near.txt")
EV3File.WriteLine(N,near)
Speaker.Note(25,"D2",1000)
EV3File.Close(N)
Buttons.Flush()
Program.Delay(1000)
Buttons.Wait()
far=Sensor.ReadPercent(3)
F=EV3File.OpenWrite("wro2019/far.txt")
EV3File.WriteLine(F,far)
Speaker.Note(25,"B2",1000)
EV3File.Close(F)