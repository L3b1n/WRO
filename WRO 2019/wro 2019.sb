A=0
B=0
C=0

X=0
Y=0
i=0

Port_compas=4

LCD.Clear()
Sensor.SetMode(3,1)
Sensor.SetMode(1,0)
Sensor.SetMode(4,0)
gamma=Math.GetRadians(90)
angle=Sensor.ReadRawValue(4,0)'EV3File.ReadByte("Filehandle")
'F=EV3File.OpenWrite("wro2019/far.txt")
far=30'EV3File.ReadLine(F)
'EV3File.Close(F)
'N=EV3File.OpenWrite("wro2019/near.txt")
near=30'EV3File.ReadLine(N)
'EV3File.Close(N)
'EV3File.Close("Filehandle")

While "True"
  LCD.Clear()
  LCD.Write(2,0,Sensor.ReadRawValue(4,0))
  Program.Delay(100)
EndWhile
Sub speed_y
  Sensor.SetMode(Port_compas,1)
  betta=Sensor.ReadRawValue(Port_compas,0)
  speed=(angle-betta)*1.3
  speedA=A+speed
  speedB=B+speed
  speedC=C+speed
  Motor.Start("A",speedA)
  Motor.Start("B",speedB)
  Motor.Start("C",speedC)
EndSub

Sub speed_x
  Sensor.SetMode(4,1)
  betta=Sensor.ReadRawValue(4,0)
  speed=(angle-betta)*2.2
  speedA=A+speed
  speedB=B+speed
  speedC=C+speed
  Motor.Start("A",speedA)
  Motor.Start("B",speedB)
  Motor.Start("C",speedC)
EndSub


Thread.Run=odometriy
Px_cm=1
Py_cm=1
Sub odometriy
  While "True"
    count_right=Motor.GetSpeed("A")
    count_left=Motor.GetSpeed("B")
    count_back=Motor.GetSpeed("C")
    
    Vy=Math.SquareRoot(Math.Power(count_right,2)+Math.Power(count_left,2)+count_right*(-1)*count_left)*Math.Cos(gamma)
    Y=Vy*0.05*Py_cm+Y
    
    Vx=((Math.SquareRoot(Math.Power(count_right,2)+Math.Power(count_left,2)-count_right*count_left)+count_back)/2)*Math.Cos(gamma)
    X=Vx*0.05*Px_cm+X
    
    While i=1
    count_A=Math.Abs(Motor.GetSpeed("A"))
    count_B=Math.Abs(Motor.GetSpeed("B"))
    count_C=Math.Abs(Motor.GetSpeed("c"))
    If count_A >= 0 And count_B >= 0 And count_C >= 0 Then
      i=1
    Else
      i=0
    EndIf 
  EndWhile
  EndWhile
EndSub



Thread.Run=show
Sub show
  While "True"
    LCD.Clear()
    LCD.Write(2,0,"x")
    LCD.Write(2,2,"y")
    LCD.Write(5,0,x)
    LCD.Write(5,2,y)
    Program.Delay(100)
  EndWhile
EndSub


While "True"
  color=Sensor.ReadPercent(3)
  zone=Sensor.ReadRawValue(1,0)
  If color >= 30 Then
    gamma=Math.GetRadians(90)
    A=-100
    B=100
    C=0
    speed_y()
  ElseIf zone=1 then
    gamma=Math.GetRadians(270)
    norm=1
    A=100
    B=-100
    C=0
    speed_y()
